# Production Configuration
LOG_LEVEL=INFO
DEVICE=cuda
API_HOST=0.0.0.0
API_PORT=8000

# Absolute paths for docker mounts
MODEL_PATH=/app/models/best.pt
ALERTS_DIR=/app/artifacts/alerts
REPORTS_DIR=/app/artifacts/reports
SNAPSHOTS_DIR=/app/artifacts/screenshots
EVENTS_DIR=/app/artifacts/events
REGISTRY_DIR=/app/artifacts/model_registry

# Postgres Database (defaults)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinelops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
